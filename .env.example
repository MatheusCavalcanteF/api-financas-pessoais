# Copie para .env (cp .env.example .env) e preencha os valores vazios.
# O .env é lido pelo docker compose e pela aplicação. Não use aspas nos
# valores: o Spring lê o arquivo como .properties e manteria as aspas.

DB_URL=jdbc:postgresql://localhost:5432/financas
DB_USERNAME=postgres
DB_PASSWORD=

# Base64, mínimo 256 bits. Gere com: openssl rand -base64 48
JWT_SECRET=

# Swagger UI e /v3/api-docs. Só para desenvolvimento: fora dele, deixe false
# ou remova a linha (o padrão é desligado).
SWAGGER_ENABLED=true
